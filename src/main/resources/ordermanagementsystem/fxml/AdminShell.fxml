<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.shiro.ordermanagementsystem.Controller.AdminShellController"
            prefWidth="1280"
            prefHeight="800"
            styleClass="admin-root"
            stylesheets="@../css/admin.css">

    <!-- ═════ TOP BAR ═════ -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" styleClass="top-bar" spacing="12">
            <Button fx:id="hamburgerButton"
                    onAction="#toggleSidebar"
                    styleClass="hamburger-button">
                <graphic>
                    <FontIcon iconLiteral="fas-bars" iconSize="16" iconColor="#444444" />
                </graphic>
            </Button>

            <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="admin-badge">
                <Label fx:id="adminAvatarLabel" text="A" styleClass="avatar-initials" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label fx:id="adminNameLabel"  text="Admin"      styleClass="admin-name" />
                    <Label fx:id="adminLevelLabel" text="SUPER_ADMIN" styleClass="admin-level" />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═════ SIDEBAR ═════ -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="240"
              minWidth="240"
              styleClass="sidebar">

            <!-- Brand / logo -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-brand">
                <FontIcon iconLiteral="fas-cube" iconSize="20" iconColor="#D92A1C" />
                <Label fx:id="brandLabel" text="OMS Admin" styleClass="brand-label" />
            </HBox>

            <Line endX="200" strokeWidth="0.5" stroke="#2a2a2a" styleClass="sidebar-divider" />

            <!-- Menu items (built in controller.initialize) -->
            <VBox fx:id="menuContainer" spacing="4" styleClass="menu-container" VBox.vgrow="ALWAYS" />

            <Line endX="200" strokeWidth="0.5" stroke="#2a2a2a" styleClass="sidebar-divider" />

            <!-- Logout -->
            <Button fx:id="logoutButton"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    styleClass="logout-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="15" iconColor="#cccccc" />
                        <Label fx:id="logoutLabel" text="Logout" styleClass="logout-label" />
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- ═════ CONTENT ═════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

</BorderPane>
