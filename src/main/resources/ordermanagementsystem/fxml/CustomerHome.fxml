<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.shiro.ordermanagementsystem.Controller.customer.CustomerHomeController"
            prefWidth="1100"
            prefHeight="720"
            styleClass="customer-root, admin-root"
            stylesheets="@../css/admin.css,@../css/customer.css">

    <!-- ═════ TOP BAR ═════ -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <Button fx:id="hamburgerButton" onAction="#toggleSidebar" styleClass="hamburger-button">
                <graphic>
                    <FontIcon iconLiteral="fas-bars" iconSize="16" iconColor="#222222" />
                </graphic>
            </Button>
            <FontIcon iconLiteral="fas-utensils" iconSize="18" iconColor="#D92A1C" />
            <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Cart pill (always visible — quick access) -->
            <Button fx:id="cartButton" onAction="#openCart" styleClass="button-secondary">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <FontIcon iconLiteral="fas-shopping-bag" iconSize="13" iconColor="#D92A1C" />
                        <Label fx:id="cartCountLabel" text="0" />
                    </HBox>
                </graphic>
            </Button>

            <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="admin-badge">
                <StackPane fx:id="customerAvatarStack" prefWidth="36" prefHeight="36"
                           minWidth="36" minHeight="36" styleClass="avatar-frame-sm">
                    <Label fx:id="customerAvatarLabel" text="C" styleClass="avatar-initials" />
                    <ImageView fx:id="customerAvatarImage" fitWidth="36" fitHeight="36"
                               preserveRatio="false" pickOnBounds="true"
                               visible="false" managed="false" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label fx:id="customerNameLabel"  text="Customer"          styleClass="admin-name" />
                    <Label fx:id="customerEmailLabel" text="email@example.com" styleClass="admin-level" />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <!-- ═════ SIDEBAR ═════ -->
    <left>
        <VBox fx:id="sidebar" prefWidth="240" minWidth="240" maxWidth="240"
              spacing="6" styleClass="sidebar">
            <Label fx:id="brandLabel" text="foodislice" styleClass="brand-label" />

            <Region prefHeight="6" />

            <VBox fx:id="menuContainer" spacing="4" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="menu-button" maxWidth="Infinity">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="15" iconColor="#cccccc" />
                        <Label fx:id="logoutLabel" text="Logout" styleClass="menu-label" />
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- ═════ CONTENT ═════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

</BorderPane>
