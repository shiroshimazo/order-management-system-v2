<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.shiro.ordermanagementsystem.Controller.LoginDashboardController"
           prefWidth="420"
           prefHeight="660"
           styleClass="login-root"
           stylesheets="@../css/login.css">

    <VBox alignment="TOP_LEFT"
          prefWidth="420"
          maxWidth="420"
          minWidth="420"
          styleClass="login-card">

        <!-- Heading -->
        <VBox spacing="6" styleClass="heading-box">
            <Label text="Welcome back" styleClass="login-title" />
            <Label text="Sign in to continue" styleClass="login-subtitle" />
        </VBox>

        <!-- Username Field -->
        <VBox spacing="6" styleClass="field-box-username">
            <Label text="Username" styleClass="field-label" />
            <HBox alignment="CENTER_LEFT"
                  spacing="0"
                  prefHeight="44"
                  styleClass="input-row">
                <FontIcon iconLiteral="far-user"
                          iconSize="14"
                          iconColor="#bbbbbb" />
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           prefHeight="44"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field" />
            </HBox>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="6" styleClass="field-box-password">
            <Label text="Password" styleClass="field-label" />
            <HBox alignment="CENTER_LEFT"
                  spacing="0"
                  prefHeight="44"
                  styleClass="input-row">
                <FontIcon iconLiteral="fas-lock"
                          iconSize="14"
                          iconColor="#bbbbbb" />
                <!-- Hidden field (default) -->
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               prefHeight="44"
                               HBox.hgrow="ALWAYS"
                               styleClass="input-field" />
                <!-- Visible field (toggled) -->
                <TextField fx:id="passwordVisible"
                           promptText="••••••••"
                           prefHeight="44"
                           visible="false"
                           managed="false"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field" />
                <!-- Eye toggle icon -->
                <FontIcon fx:id="toggleIcon"
                          styleClass="toggle-icon"
                          onMouseClicked="#togglePasswordVisibility" />
            </HBox>
        </VBox>

        <!-- Forgot Password -->
        <HBox alignment="CENTER_RIGHT" styleClass="forgot-box">
            <Hyperlink text="Forgot password?"
                       onAction="#handleForgotPassword"
                       styleClass="forgot-link" />
        </HBox>

        <!-- Error Label (space always reserved — button never shifts) -->
        <Label fx:id="errorLabel"
               text=""
               wrapText="true"
               maxWidth="Infinity"
               minHeight="18"
               styleClass="error-label" />

        <!-- Sign In Button -->
        <Button fx:id="loginButton"
                text="Sign in"
                onAction="#handleLogin"
                prefHeight="46"
                maxWidth="Infinity"
                styleClass="login-button" />

        <Region prefHeight="20" />

        <!-- Divider with OR -->
        <HBox alignment="CENTER" spacing="10" styleClass="divider-box">
            <Line endX="100"
                  strokeWidth="0.5"
                  stroke="#e0e0e0"
                  HBox.hgrow="ALWAYS" />
            <Label text="or" styleClass="divider-label" />
            <Line endX="100"
                  strokeWidth="0.5"
                  stroke="#e0e0e0"
                  HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Create Account -->
        <HBox alignment="CENTER" spacing="2">
            <Label text="Don't have an account?" styleClass="no-account-label" />
            <Hyperlink text="Create account"
                       onAction="#handleCreateAccount"
                       styleClass="create-account-link" />
        </HBox>



    </VBox>

</StackPane>
