<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.shiro.ordermanagementsystem.Controller.ForgotPasswordDashboardController"
           prefWidth="420"
           prefHeight="760"
           styleClass="forgot-root"
           stylesheets="@../css/login.css">

    <VBox alignment="TOP_LEFT"
          prefWidth="420"
          maxWidth="420"
          minWidth="420"
          styleClass="login-card">

        <!-- Back Button -->
        <HBox alignment="CENTER_LEFT" styleClass="back-box">
            <Button fx:id="backButton"
                    onAction="#handleBackToLogin"
                    styleClass="back-button">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left"
                              iconSize="14"
                              iconColor="#666666" />
                </graphic>
            </Button>
        </HBox>

        <!-- Heading -->
        <VBox spacing="6" styleClass="heading-box">
            <Label text="Reset Password" styleClass="login-title" />
            <Label text="Verify your email, then set a new password" styleClass="login-subtitle" />
        </VBox>

        <!-- Email Field (with Send button inside row) -->
        <VBox spacing="6" styleClass="field-box">
            <Label text="Email" styleClass="field-label" />
            <HBox alignment="CENTER_LEFT"
                  spacing="0"
                  prefHeight="44"
                  styleClass="input-row">
                <FontIcon iconLiteral="fas-envelope"
                          iconSize="14"
                          iconColor="#bbbbbb" />
                <TextField fx:id="emailField"
                           promptText="you@example.com"
                           prefHeight="44"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field" />
                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#handleSendCode"
                        styleClass="send-button" />
            </HBox>
        </VBox>

        <!-- Verification Code Field (timer inside row, Verify button beside) -->
        <VBox spacing="6" styleClass="field-box">
            <Label text="Verification Code" styleClass="field-label" />
            <HBox alignment="CENTER_LEFT" spacing="8" prefHeight="44">
                <HBox alignment="CENTER_LEFT"
                      spacing="0"
                      prefHeight="44"
                      HBox.hgrow="ALWAYS"
                      styleClass="input-row">
                    <FontIcon iconLiteral="fas-shield-alt"
                              iconSize="14"
                              iconColor="#bbbbbb" />
                    <TextField fx:id="codeField"
                               promptText="6-digit code"
                               prefHeight="44"
                               HBox.hgrow="ALWAYS"
                               styleClass="input-field" />
                    <Label fx:id="countdownLabel"
                           text=""
                           visible="false"
                           managed="false"
                           styleClass="countdown-label" />
                </HBox>
                <Button fx:id="verifyButton"
                        text="Verify"
                        onAction="#handleVerifyCode"
                        prefHeight="44"
                        styleClass="verify-button" />
            </HBox>
        </VBox>

        <!-- New Password Field -->
        <VBox spacing="6" styleClass="field-box">
            <Label text="New Password" styleClass="field-label" />
            <HBox fx:id="newPasswordRow"
                  alignment="CENTER_LEFT"
                  spacing="0"
                  prefHeight="44"
                  disable="true"
                  styleClass="input-row">
                <FontIcon iconLiteral="fas-lock"
                          iconSize="14"
                          iconColor="#bbbbbb" />
                <PasswordField fx:id="newPasswordField"
                               promptText="••••••••"
                               prefHeight="44"
                               HBox.hgrow="ALWAYS"
                               styleClass="input-field" />
                <TextField fx:id="newPasswordVisible"
                           promptText="••••••••"
                           prefHeight="44"
                           visible="false"
                           managed="false"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field" />
                <FontIcon fx:id="toggleNewIcon"
                          styleClass="toggle-icon"
                          onMouseClicked="#toggleNewPasswordVisibility" />
            </HBox>
        </VBox>

        <!-- Confirm Password Field -->
        <VBox spacing="6" styleClass="field-box">
            <Label text="Confirm Password" styleClass="field-label" />
            <HBox fx:id="confirmPasswordRow"
                  alignment="CENTER_LEFT"
                  spacing="0"
                  prefHeight="44"
                  disable="true"
                  styleClass="input-row">
                <FontIcon iconLiteral="fas-lock"
                          iconSize="14"
                          iconColor="#bbbbbb" />
                <PasswordField fx:id="confirmPasswordField"
                               promptText="••••••••"
                               prefHeight="44"
                               HBox.hgrow="ALWAYS"
                               styleClass="input-field" />
                <TextField fx:id="confirmPasswordVisible"
                           promptText="••••••••"
                           prefHeight="44"
                           visible="false"
                           managed="false"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field" />
                <FontIcon fx:id="toggleConfirmIcon"
                          styleClass="toggle-icon"
                          onMouseClicked="#toggleConfirmPasswordVisibility" />
            </HBox>
        </VBox>

        <!-- Error Label (space always reserved) -->
        <Label fx:id="errorLabel"
               text=""
               wrapText="true"
               maxWidth="Infinity"
               minHeight="18"
               styleClass="error-label" />

        <!-- Reset Password Button -->
        <Button fx:id="resetButton"
                text="Reset Password"
                onAction="#handleResetPassword"
                prefHeight="46"
                maxWidth="Infinity"
                disable="true"
                styleClass="login-button" />

    </VBox>

</StackPane>
