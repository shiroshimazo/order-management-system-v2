<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shiro.ordermanagementsystem.Controller.admin.ProductFormDialogController"
      prefWidth="520"
      spacing="16"
      styleClass="settings-card">

    <Label fx:id="titleLabel" text="Add Product" styleClass="section-title" />
    <Separator />

    <GridPane hgap="14" vgap="12" styleClass="form-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="SKU *" styleClass="form-label" />
            <TextField fx:id="skuField" promptText="e.g. SKU-0001" styleClass="form-field" />
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Category" styleClass="form-label" />
            <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="form-field" />
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
            <Label text="Name *" styleClass="form-label" />
            <TextField fx:id="nameField" promptText="Product name" styleClass="form-field" />
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <Label text="Description" styleClass="form-label" />
            <TextArea fx:id="descriptionField"
                      promptText="Optional product description"
                      prefRowCount="3"
                      wrapText="true"
                      styleClass="form-field" />
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Price *" styleClass="form-label" />
            <TextField fx:id="priceField" promptText="0.00" styleClass="form-field" />
        </VBox>

        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Stock *" styleClass="form-label" />
            <TextField fx:id="stockField" promptText="0" styleClass="form-field" />
        </VBox>
    </GridPane>

    <CheckBox fx:id="activeCheck" text="Active (visible in catalog)" selected="true" />

    <Label fx:id="messageLabel" text="" styleClass="form-message" managed="false" visible="false" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="button-secondary" />
        <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="button-primary" />
    </HBox>
</VBox>
