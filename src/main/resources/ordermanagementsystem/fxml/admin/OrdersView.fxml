<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shiro.ordermanagementsystem.Controller.admin.OrdersController"
      spacing="16"
      styleClass="dashboard-view">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Orders" styleClass="dashboard-greeting" />
            <Label text="Manage customer orders and update their status" styleClass="dashboard-subgreeting" />
        </VBox>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="button-secondary" />
    </HBox>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fas-search" iconSize="13" iconColor="#888888" />
            <TextField fx:id="searchField"
                       promptText="Search by order # or customer name…"
                       styleClass="search-field"
                       HBox.hgrow="ALWAYS" />
            <Label text="Ctrl+K" styleClass="kbd-hint" />
        </HBox>
        <Label text="Status:" styleClass="form-label" />
        <ComboBox fx:id="statusFilter" prefWidth="160" styleClass="form-field" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="chart-card" spacing="8" VBox.vgrow="ALWAYS">
        <TableView fx:id="ordersTable" styleClass="mini-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCode"     text="Order #"  prefWidth="110" />
                <TableColumn fx:id="colCustomer" text="Customer" prefWidth="180" />
                <TableColumn fx:id="colDate"     text="Placed"   prefWidth="160" />
                <TableColumn fx:id="colTotal"    text="Total"    prefWidth="110" />
                <TableColumn fx:id="colStatus"   text="Status"   prefWidth="110" />
                <TableColumn fx:id="colActions"  text="Actions"  prefWidth="110" />
            </columns>
            <placeholder>
                <VBox styleClass="empty-state">
                    <FontIcon iconLiteral="fas-receipt" iconSize="36" iconColor="#cfd2d8" />
                    <Label text="No orders yet" styleClass="empty-state-title" />
                    <Label text="Orders placed by customers will appear here." styleClass="empty-state-subtitle" />
                </VBox>
            </placeholder>
        </TableView>
        <Label fx:id="countLabel" text="0 orders" styleClass="dashboard-subgreeting" />
    </VBox>
</VBox>
