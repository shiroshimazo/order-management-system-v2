<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shiro.ordermanagementsystem.Controller.admin.ProductsController"
      spacing="16"
      styleClass="dashboard-view">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Products" styleClass="dashboard-greeting" />
            <Label text="Manage your catalog, pricing and stock" styleClass="dashboard-subgreeting" />
        </VBox>
        <Button onAction="#handleManageCategories" styleClass="button-secondary">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <FontIcon iconLiteral="fas-tags" iconSize="12" iconColor="#555555" />
                    <Label text="Manage Categories" />
                </HBox>
            </graphic>
        </Button>
        <Button onAction="#handleAddProduct" styleClass="button-primary">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#ffffff" />
                    <Label text="Add Product" style="-fx-text-fill: #ffffff;" />
                </HBox>
            </graphic>
        </Button>
    </HBox>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <FontIcon iconLiteral="fas-search" iconSize="13" iconColor="#888888" />
            <TextField fx:id="searchField"
                       promptText="Search by name or SKU…"
                       styleClass="search-field"
                       HBox.hgrow="ALWAYS" />
        </HBox>
        <Label text="Category:" styleClass="form-label" />
        <ComboBox fx:id="categoryFilter" prefWidth="180" styleClass="form-field" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="button-secondary" />
    </HBox>

    <!-- Table card -->
    <VBox styleClass="chart-card" spacing="8" VBox.vgrow="ALWAYS">
        <TableView fx:id="productsTable" styleClass="mini-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSku"        text="SKU"        prefWidth="110" />
                <TableColumn fx:id="colName"       text="Name"       prefWidth="220" />
                <TableColumn fx:id="colCategory"   text="Category"   prefWidth="130" />
                <TableColumn fx:id="colPrice"      text="Price"      prefWidth="100" />
                <TableColumn fx:id="colStock"      text="Stock"      prefWidth="80" />
                <TableColumn fx:id="colStatus"     text="Status"     prefWidth="90" />
                <TableColumn fx:id="colActions"    text="Actions"    prefWidth="140" />
            </columns>
            <placeholder>
                <Label text="No products yet. Click 'Add Product' to create one." styleClass="dashboard-subgreeting" />
            </placeholder>
        </TableView>
        <Label fx:id="countLabel" text="0 products" styleClass="dashboard-subgreeting" />
    </VBox>

</VBox>
