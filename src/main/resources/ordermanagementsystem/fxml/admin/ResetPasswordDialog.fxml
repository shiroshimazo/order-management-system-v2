<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shiro.ordermanagementsystem.Controller.admin.ResetPasswordDialogController"
      prefWidth="440"
      spacing="14"
      styleClass="settings-card">

    <Label fx:id="titleLabel" text="Reset Password" styleClass="section-title" />
    <Label fx:id="subtitleLabel" text="" styleClass="dashboard-subgreeting" />
    <Separator />

    <VBox spacing="6">
        <Label text="New Password *" styleClass="form-label" />
        <PasswordField fx:id="newPasswordField" promptText="Minimum 8 characters" styleClass="form-field" />
    </VBox>

    <VBox spacing="6">
        <Label text="Confirm Password *" styleClass="form-label" />
        <PasswordField fx:id="confirmField" promptText="Retype new password" styleClass="form-field" />
    </VBox>

    <Label fx:id="messageLabel" text="" styleClass="form-message" managed="false" visible="false" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="button-secondary" />
        <Button text="Reset Password" onAction="#handleReset" styleClass="button-primary" />
    </HBox>
</VBox>
